<% I18n.with_locale(@locale) do %>
  <header class="header text-xs">
    <div class="flex justify-between">
      <%= image_tag("images/logo_cheyere.png") %>
      <table>
        <tbody>
          <tr>
            <th colspan="2" class="px-2 bg-gray-200 border-1 rounded rounded-b-none text-2xl">
              <%= t("views.organization.#{@project_type}.title")  %>
            </th>
          </tr>
          <% [{
            label: t("views.organization.#{@project_type}.number"),
            data: @project.number
          }, {
            label: t("views.organization.#{@project_type}.version.number"),
            data: @project_version.number
          }, {
            label: t("views.organization.#{@project_type}.issue_date"), 
            data: l(@project_version.created_at, format: :short)
          }].each_with_index do |row, index| %>
            <tr class="group">
              <th class="text-left px-2 bg-gray-200 border-1 border-t-0 group-[:last-child]:rounded-bl">
                <%= row[:label] %>
              </th>
              <td class="px-2 text-right border-1 border-t-0 border-l-0 group-[:last-child]:rounded-br">
                <%= row[:data] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </header>

  <main class="text-xs">
    <section class="mb-8">
      <table class="w-full">
            <tbody>
                <tr>
                    <th colspan="2" class="px-2 py-1 bg-gray-200 border rounded rounded-b-none">
                        <%= t("views.organization.#{@project_type}.context.title") %>
                    </th>
                </tr>
                <tr>
                    <td class="px-2 py-1 border-1 border-t-0">
                    <%= t("views.organization.#{@project_type}.context.name_html",
                            name: @project.name) %>
                    </td>
                </tr>
                <tr>
                    <td class="px-2 py-1 border-1 border-t-0 rounded-b">
                    <%= t("views.organization.#{@project_type}.context.address_html",
                            street: @project.address_street,
                            zipcode: @project.address_zipcode,
                            city: @project.address_city) %>
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
    <section class="mb-8">
      <table class="mb-8 w-full">
        <tbody>
          <tr>
            <th colspan="2" class="px-2 py-1 bg-gray-200 rounded rounded-b-none border-1">
              <%= t("views.organization.completion_snapshots.invoice.seller_details.title") %>
            </th>
          </tr>
          <% [
            {
              label: t("views.organization.completion_snapshots.invoice.seller_details.name_label"),
              content: @project.company.name
            },
            {
              label: t("views.organization.completion_snapshots.invoice.seller_details.address_label"),
              content: t("views.organization.completion_snapshots.invoice.seller_details.address_value",
                        street: @project.company.address_street,
                        city: @project.company.address_city,
                        zip: @project.company.address_zipcode)
            },
            {
              label: t("views.organization.completion_snapshots.invoice.seller_details.phone_label"),
              content: @project.company.phone
            },
          ].each do |row| %>
            <% next unless row[:content] %>
            <tr class="group">
              <th class="bg-gray-200 w-44 text-left px-2 py-0.5 border-1 border-t-0 group-last:rounded-bl">
                <%= row[:label] %>
              </th>
              <td class="px-2 py-0.5 text-right border-1 border-t-0 border-l-0 group-last:rounded-br">
                <%= row[:content] || "NA" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <table class="mb-8 w-full">
        <tbody>
          <tr>
            <th colspan="2" class="px-2 py-1 bg-gray-200 rounded rounded-b-none border-1">
              Client
            </th>
          </tr>
          <% [
            {
              label: t("views.accounting.invoice.shared.client_name_label"), 
              content: @project.client.name
            },
            {
              label: t("views.accounting.invoice.shared.client_email_label"), 
              content: @project.client.email
            },
            {
              label: t("views.accounting.invoice.shared.client_phone_label"), 
              content: @project.client.phone
            },
            {
              label: t("views.accounting.invoice.shared.client_vat_number_label"), 
              content: @project.client.vat_number
            },
            {
              label:t("views.accounting.invoice.shared.client_registration_number_label"), 
              content: @project.client.registration_number
            },
          ].each do |row| %>
            <% next unless row[:content] %>
            <tr class="group">
              <th class="bg-gray-200 w-44 text-left px-2 py-0.5  border-1 border-t-0 group-last:rounded-bl">
                <%= row[:label] %>
              </th>
              <td class="px-2 py-0.5 text-right border-1 border-t-0 border-l-0 group-last:rounded-br">
                <%= row[:content] || "NA" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
    <section class="mb-8">
      <% @project_version.item_groups.each do |group| %>
        <%= render "project_group", group: group, items: group.grouped_items %>
      <% end %>
    </section>
    <section class="mb-8">
      <%= render "project_total", project_version_total_excl_tax_amount: @project_version_total_excl_tax_amount, project_version_vat_amount: @project_version_vat_amount %>
    </section>

    <section class="break-before-page prose prose-sm mx-auto">
      <h1 class="text-center text-xl font-bold"><%= t("views.shared.general_terms_and_conditions") %></h1>
      <%= sanitize(@project_version.general_terms_and_conditions) %>
    </section>
  </main>
<% end %>
